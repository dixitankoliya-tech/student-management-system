FROM dunglas/frankenphp:1-php8.3

# Set the document root to the application directory
ENV SERVER_NAME=":${PORT:-80}"

# Install required PHP extensions for the Student Management System
RUN install-php-extensions pdo_mysql opcache

# Copy the entire application code into the FrankenPHP public directory
COPY . /app/public/

# Ensure proper permissions
RUN chown -R www-data:www-data /app/public
