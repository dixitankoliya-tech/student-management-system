{
  "version": 2,
  "regions": ["sin1"],
  "functions": {
    "api/*.php": {
      "runtime": "vercel-php@0.9.0"
    }
  },
  "routes": [
    {
      "src": "/assets/(.*)",
      "headers": { "cache-control": "public, max-age=86400, stale-while-revalidate=604800" },
      "dest": "/assets/$1"
    },
    {
      "src": "/admin/assets/(.*)",
      "headers": { "cache-control": "public, max-age=86400, stale-while-revalidate=604800" },
      "dest": "/admin/assets/$1"
    },
    {
      "src": "/student/assets/(.*)",
      "headers": { "cache-control": "public, max-age=86400, stale-while-revalidate=604800" },
      "dest": "/student/assets/$1"
    },
    {
      "src": "/faculty/assets/(.*)",
      "headers": { "cache-control": "public, max-age=86400, stale-while-revalidate=604800" },
      "dest": "/faculty/assets/$1"
    },
    {
      "src": "/uploads/(.*)",
      "headers": { "cache-control": "public, max-age=86400, stale-while-revalidate=604800" },
      "dest": "/uploads/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/api/index.php"
    }
  ]
}
