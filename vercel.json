{
  "version": 2,
  "buildCommand": "echo 'No build step required for container.'",
  "routes": [
    {
      "src": "/admin",
      "dest": "/admin/index.php"
    },
    {
      "src": "/faculty",
      "dest": "/faculty/index.php"
    },
    {
      "src": "/student",
      "dest": "/student/index.php"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ]
}
